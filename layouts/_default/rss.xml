{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = site }}{{- end -}}

{{- $pages := slice -}}
{{- if $.IsHome -}}
    {{- $sections := site.Params.rssSections -}}
    {{- if $sections -}}
        {{- $pages = where $pctx.RegularPages "Section" "in" $sections -}}
    {{- else -}}
        {{- $pages = where $pctx.RegularPages "Section" "ne" "rss" -}}
        {{- $pages = where $pages "Params.searchHidden" "!=" true -}}
        {{- $pages = where $pages "Type" "ne" "about" -}}
    {{- end -}}
{{- else if $.IsSection -}}
    {{- $pages = $pctx.RegularPages -}}
{{- else -}}
    {{- $pages = $pctx.Pages -}}
{{- end -}}

{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
    {{- $pages = $pages | first $limit -}}
{{- end -}}

{{- $fullContent := ne site.Params.rssFullContent false -}}
{{- $authorEmail := site.Params.email | default site.Params.social.email -}}

{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ if eq .Title site.Title }}{{ site.Title | transform.XMLEscape }}{{ else }}{{ with .Title }}{{ . | transform.XMLEscape }} | {{ end }}{{ site.Title | transform.XMLEscape }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ with .Description }}{{ . | transform.XMLEscape }}{{ else }}{{ site.Params.description | transform.XMLEscape }}{{ end }}</description>
    <language>{{ site.Language.Lang }}</language>

    <copyright>{{ now.Year }} {{ site.Params.author | transform.XMLEscape }}</copyright>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>

    {{ with $authorEmail }}
    <managingEditor>{{ . }}{{ with site.Params.author }} ({{ . }}){{ end }}</managingEditor>
    <webMaster>{{ . }}{{ with site.Params.author }} ({{ . }}){{ end }}</webMaster>
    {{ end }}

    {{ with .OutputFormats.Get "RSS" -}}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{ end -}}

    {{ range $pages }}
    {{- $itemDate := .Date -}}
    {{- if $itemDate.IsZero }}{{ $itemDate = .Lastmod }}{{ end -}}
    {{- if $itemDate.IsZero }}{{ $itemDate = now }}{{ end -}}
    <item>
      <title>{{ .Title | transform.XMLEscape }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ $itemDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{ with $authorEmail }}
      <author>{{ . }}{{ with site.Params.author }} ({{ . }}){{ end }}</author>
      {{ end }}
      {{ with site.Params.author }}
      <dc:creator>{{ . | transform.XMLEscape }}</dc:creator>
      {{ end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ if $fullContent }}{{ .Content | transform.XMLEscape | safeHTML }}{{ else }}{{ with .Description }}{{ . | transform.XMLEscape }}{{ else }}{{ .Summary | transform.XMLEscape }}{{ end }}{{ end }}</description>
      {{ with .Params.tags }}
      {{ range . }}
      <category>{{ . | transform.XMLEscape }}</category>
      {{ end }}
      {{ end }}
    </item>
    {{ end }}
  </channel>
</rss>
